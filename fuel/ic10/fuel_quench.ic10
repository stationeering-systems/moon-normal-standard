# Enthalpy formula constants (350-1000 K):
# a(T-50)^3 + b(T-50)^2 + c(T-50) + d
define EntA -0.00003527525986
define EntB 0.07054156799
define EntC -24.59598895
define EntD 2329.680819

define Patm 101.325
define SpecificHeatVolatiles 23.57
define SpecificHeatPollutant 24.8
define LatentHeatVolatiles 50
define LatentHeatHydrochloricAcid 1000
define LatentHeatPollutant 2000

define TargetTemperature 342
define PollutantFuelRatio 0.03
define kR 3.46
define kN 2
define V 20

alias QuenchPipe d0
alias QuenchPump d1
alias DrainPump d2
alias DewPipe d3

alias SpecificHeat r0
alias LatentHeat r1
alias TargetMoles r2
alias QT r3
alias Er r4
alias Edelta r5
alias MaxMoles r6

alias TargetPollutant r7
add TargetPollutant PollutantFuelRatio 1
div TargetPollutant PollutantFuelRatio TargetPollutant

alias MolarFactor r8
mul MolarFactor Patm V
div MolarFactor MolarFactor rgas

s QuenchPipe On 1
s QuenchPipe Lock 1
s DewPipe On 1
s DewPipe Lock 1

main:
  s QuenchPump Setting 0
  s DrainPump On 1
  yield
  # (Dew) Specific + Latent Heat
  push 3 # DewPipe
  jal heat
  l r15 DewPipe TotalMoles
  l r14 DewPipe Temperature
  mul r13 SpecificHeat TargetTemperature
  sub r13 r13 LatentHeat   # expected E/mol
  mul r12 r14 SpecificHeat # actual E/mol
  sub r13 r13 r12
  mul Edelta r13 r15  # (+)cold/(-)hot
quench:
  # (Quench) Specific + Latent Heat
  push 0 # QuenchPipe
  jal heat
  l QT QuenchPipe Temperature
  div QT QT kN
  # Get max moles
  mul QT QT 2
  jal er
  div QT QT 2
  mul r15 QT SpecificHeat
  div MaxMoles Er r15
  # Get target moles
  jal er
  add r15 Er Edelta
  sub r14 QT TargetTemperature
  mul r14 r14 SpecificHeat
  add r14 r14 LatentHeat
  div TargetMoles r15 r14
  select TargetMoles r14 TargetMoles 0
  min TargetMoles TargetMoles MaxMoles
  l r15 QuenchPipe TotalMoles
  l r14 QuenchPipe Volume
  select TargetMoles r15 TargetMoles 0
  s db Setting TargetMoles
  # Update the pump rate
  div r13 MolarFactor QT
  blt TargetMoles r13 main # ensure moles > p_atm
  div r13 TargetMoles r15
  bgt r13 1 main
  mul r13 r13 r14
  s DrainPump On 0
  s QuenchPump Setting r13
  yield
  j main
er:
  sub r15 QT 50
  pow r14 r15 3
  mul r14 r14 EntA
  pow r13 r15 2
  mul r13 r13 EntB
  add r14 r14 r13
  mul r13 r15 EntC
  add r14 r14 r13
  add r14 r14 EntD
  mul Er r14 kR
  j ra
heat:
  pop r15 # device index
  l r14 dr15 RatioPollutant
  l r13 dr15 RatioLiquidPollutant
  l r12 dr15 RatioLiquidHydrochloricAcid
  add r11 r14 r13 # RatioPollutant
  sub r10 1 r11 # RatioVolatiles
  mul SpecificHeat r11 SpecificHeatPollutant
  mul r9 r10 SpecificHeatVolatiles
  add SpecificHeat SpecificHeat r9
  sub r9 r14 TargetPollutant
  mul LatentHeat r9 LatentHeatPollutant
  mul r9 r12 LatentHeatHydrochloricAcid
  sub LatentHeat LatentHeat r9
  mul r9 r10 LatentHeatVolatiles
  add LatentHeat LatentHeat r9
  j ra